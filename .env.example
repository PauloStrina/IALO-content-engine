OPENAI_API_KEY=

# Blotato native publishing layer.
BLOTATO_API_KEY=
BLOTATO_BASE_URL=https://backend.blotato.com/v2
BLOTATO_TARGETS_JSON=
BLOTATO_UPLOAD_MEDIA=false
BLOTATO_DELAY_SECONDS=5
BLOTATO_MAX_ATTEMPTS=3

# Optional alternative to BLOTATO_TARGETS_JSON.
# Example keys for a platform called instagram:
# BLOTATO_ACCOUNT_INSTAGRAM=
# BLOTATO_PLATFORM_INSTAGRAM=instagram
# BLOTATO_TARGET_TYPE_INSTAGRAM=instagram
# BLOTATO_PAGE_ID_INSTAGRAM=

# Public assets. The GitHub Actions workflow sets this automatically for raw.githubusercontent.com.
PUBLIC_ASSET_BASE_URL=
PUBLISH_RUN_ID=
PUBLISH_START_DATE=
PUBLISH_TIMEZONE=America/Argentina/Buenos_Aires
PUBLISH_UTC_OFFSET=-03:00

# Optional manual video assets for reels/clips.
MANUAL_VIDEO_ASSETS_PATH=manual-assets/video-assets.json

# Future integrations
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
ASSET_BASE_URL=
