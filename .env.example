OPENAI_API_KEY=

# Blotato publishing layer.
# BLOTATO_API_URL can be a Blotato webhook/API endpoint that receives the generated scheduled-post payload.
BLOTATO_API_KEY=
BLOTATO_API_URL=
BLOTATO_SEND_MODE=batch
BLOTATO_INCLUDE_DRAFTS=false

# Public assets. The GitHub Actions workflow sets this automatically for raw.githubusercontent.com.
PUBLIC_ASSET_BASE_URL=
PUBLISH_RUN_ID=
PUBLISH_START_DATE=
PUBLISH_TIMEZONE=America/Argentina/Buenos_Aires
PUBLISH_UTC_OFFSET=-03:00

# Optional manual video assets for reels/clips.
MANUAL_VIDEO_ASSETS_PATH=manual-assets/video-assets.json

# Future integrations
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
ASSET_BASE_URL=
