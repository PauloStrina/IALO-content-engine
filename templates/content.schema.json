{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PauloStrina/IALO-content-engine/templates/content.schema.json",
  "title": "IALO Manual Carousel Input",
  "description": "Contrato de entrada para carruseles creados por co-creación humana en ChatGPT Proyecto. GitHub no crea el contenido: recibe el texto final y lo renderiza en V01/V02.",
  "type": "object",
  "required": [
    "content_id",
    "thesis_id",
    "format",
    "channel",
    "slides"
  ],
  "properties": {
    "content_id": {
      "type": "string",
      "description": "ID estable del contenido. Ejemplo: 2026-07-w01-carousel-a"
    },
    "content_origin": {
      "type": "string",
      "enum": ["manual_chat_cocreation"],
      "default": "manual_chat_cocreation",
      "description": "El contenido nace de co-creación humana en este chat de proyecto. No lo genera GitHub."
    },
    "thesis_id": {
      "type": "string",
      "enum": [
        "01_acceptance_inner_dialogue",
        "02_inner_change_outer_change",
        "03_invisible_culture",
        "04_follow_enthusiasm"
      ]
    },
    "variant_id": {
      "type": "string",
      "description": "Variante narrativa opcional. Ejemplo: problema_conexion, metodo_pregunta_practica."
    },
    "format": {
      "type": "string",
      "enum": ["instagram_carousel"]
    },
    "channel": {
      "type": "string",
      "enum": ["instagram"]
    },
    "title": {
      "type": "string",
      "description": "Nombre humano del carrusel."
    },
    "notes": {
      "type": "string",
      "description": "Notas editoriales internas opcionales."
    },
    "objective": {
      "type": "string"
    },
    "symbol": {
      "type": "string"
    },
    "emotion": {
      "type": "string"
    },
    "cta": {
      "type": "string"
    },
    "approval": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["pending_human_approval", "approved", "rejected"],
          "default": "pending_human_approval"
        },
        "approved_version": {
          "type": ["string", "null"],
          "enum": ["v01_cinematic_sober", "v02_minimal_constant_text", null]
        },
        "approved_by": {
          "type": ["string", "null"]
        },
        "approved_at": {
          "type": ["string", "null"]
        }
      }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "description": "Cantidad variable. El orden del array define el orden del carrusel. El renderer calcula automáticamente X/N.",
      "items": {
        "type": "object",
        "required": ["text"],
        "properties": {
          "number": {
            "type": "integer",
            "minimum": 1,
            "description": "Opcional. Si no está, el renderer usa la posición en el array."
          },
          "role": {
            "type": "string",
            "description": "Rol narrativo opcional: hook, tension, cost, reframe, question, closing, etc."
          },
          "layout": {
            "type": "string",
            "description": "Layout opcional para V01. Si falta, el renderer lo infiere por posición/role. V02 ignora layouts y mantiene texto fijo."
          },
          "background": {
            "type": "string",
            "description": "Fondo opcional desde la carpeta de la tesis. Si falta, el renderer rota los fondos disponibles."
          },
          "text": {
            "type": "string",
            "description": "Texto principal del slide, escrito por humanos. Soporta saltos de línea con \\n."
          },
          "supporting_text": {
            "type": "string",
            "description": "Texto secundario opcional."
          }
        }
      }
    }
  }
}
